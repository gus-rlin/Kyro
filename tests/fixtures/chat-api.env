# Synthetic integration only. These endpoints and credentials cannot reach Nebius.
KYRO_ENV=development
KYRO_BIND=0.0.0.0:58690
KYRO_DATABASE_URL=postgres://kyro_api@kyro-chat-test-db:5432/kyro_chat_e2e
KYRO_WORKER_DATABASE_URL=postgres://kyro_worker@kyro-chat-test-db:5432/kyro_chat_e2e
KYRO_MAX_CONNECTIONS=4
KYRO_MAX_BODY_BYTES=49152
KYRO_WORKER_POLL_MS=100
KYRO_LEASE_SECONDS=10
KYRO_SYNTHETIC_PROVIDERS=true
KYRO_OIDC_ISSUER=http://127.0.0.1:59690/issuer
KYRO_OIDC_AUTHORIZATION_ENDPOINT=http://127.0.0.1:59690/oidc/authorize
KYRO_OIDC_TOKEN_ENDPOINT=http://127.0.0.1:59690/oidc/token
KYRO_OIDC_JWKS_URI=http://127.0.0.1:59690/oidc/jwks
KYRO_OIDC_REDIRECT_URI=http://127.0.0.1:58690/v1/auth/callback
KYRO_OIDC_CLIENT_ID=kyro-e2e-client
KYRO_OIDC_SYNTHETIC_PROVIDER=true
KYRO_AUTH_UI_ORIGIN=http://127.0.0.1:58690
KYRO_MODEL_REGISTRY_PATH=/workspace/tests/fixtures/models.chat.synthetic.json
KYRO_MODEL_ALLOW_SYNTHETIC_LOOPBACK=1
RUST_LOG=kyro_api=info,kyro_worker=info
