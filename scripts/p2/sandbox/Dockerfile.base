# Rebuildable public tools parent. Any new image/root digest requires fresh
# isolation qualification; this is not the identity of an already tested root.
FROM rust:1.96.1-slim-bookworm@sha256:e18a79fc84dfcfc3ab5ba72290398a644c135c97eaa881447fddc354ee4701a3 AS rust
FROM node:24.18.0-bookworm-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d
RUN apt-get update && apt-get install --no-install-recommends -y build-essential pkg-config ca-certificates openssl python3 && rm -rf /var/lib/apt/lists/*
COPY --from=rust /usr/local/rustup /root/.rustup
COPY --from=rust /usr/local/cargo/bin /root/.cargo/bin
ENV RUSTUP_HOME=/root/.rustup CARGO_HOME=/root/.cargo PATH=/root/.cargo/bin:$PATH
WORKDIR /workspace
