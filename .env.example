# Configuration locale de developpement uniquement; remplacer les URL locales au besoin.
# Ne pas utiliser ces identifiants synthétiques en production.
KYRO_ENV=development
KYRO_BIND=127.0.0.1:8080
KYRO_DATABASE_URL=postgres://kyro_api:local-only@127.0.0.1:55440/kyro_p1
KYRO_WORKER_DATABASE_URL=postgres://kyro_worker:local-only@127.0.0.1:55440/kyro_p1
KYRO_DATABASE_ADMIN_URL=postgres://kyro_admin:local-only@127.0.0.1:55440/kyro_p1
KYRO_MAX_CONNECTIONS=8
KYRO_WORKER_POLL_MS=100
KYRO_LEASE_SECONDS=10
KYRO_MAX_BODY_BYTES=262144
KYRO_SYNTHETIC_PROVIDERS=false

# Le fournisseur d'identite synthétique et ses endpoints loopback sont réservés au développement.
KYRO_AUTH_UI_ORIGIN=http://127.0.0.1:3000
KYRO_AUTH_MAX_ACTIVE_SESSIONS=100000
KYRO_OIDC_SYNTHETIC_PROVIDER=true
KYRO_OIDC_ISSUER=http://127.0.0.1:9090/issuer
KYRO_OIDC_AUTHORIZATION_ENDPOINT=http://127.0.0.1:9090/oidc/authorize
KYRO_OIDC_TOKEN_ENDPOINT=http://127.0.0.1:9090/oidc/token
KYRO_OIDC_JWKS_URI=http://127.0.0.1:9090/oidc/jwks
KYRO_OIDC_REDIRECT_URI=http://127.0.0.1:8080/v1/auth/callback
KYRO_OIDC_CLIENT_ID=kyro-e2e-client

# Registre d'exemple desactive. Aucun identifiant de fournisseur n'est fourni.
KYRO_MODEL_REGISTRY_PATH=config/models.example.json
KYRO_MODEL_ALLOW_SYNTHETIC_LOOPBACK=0
