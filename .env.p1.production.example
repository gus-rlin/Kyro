# Copy to an untracked deployment environment file and supply real locations/values.
# This template deliberately has no credentials, endpoints, certificate, image digest or keys.
KYRO_P1_DATABASE=kyro_p1
KYRO_DATABASE_ADMIN_USER=kyro_admin
KYRO_P1_RUNTIME_IMAGE=

# Host paths provisioned by the deployment secret manager.
KYRO_DATABASE_ADMIN_PASSWORD_FILE=
KYRO_DATABASE_ADMIN_URL_FILE=
KYRO_API_DATABASE_URL_FILE=
KYRO_WORKER_DATABASE_URL_FILE=
KYRO_POSTGRES_CA_FILE=
KYRO_POSTGRES_TLS_DIRECTORY=
KYRO_OIDC_CLIENT_SECRET_FILE=
KYRO_MODEL_API_KEY_FILE=

# Explicit production resource limits (the application rejects missing/out-of-range values).
KYRO_MAX_CONNECTIONS=
KYRO_WORKER_POLL_MS=
KYRO_LEASE_SECONDS=
KYRO_MAX_BODY_BYTES=

# OIDC provider configuration for the API; no wildcards in the UI origin.
KYRO_AUTH_UI_ORIGIN=
KYRO_AUTH_MAX_ACTIVE_SESSIONS=
KYRO_OIDC_ISSUER=
KYRO_OIDC_AUTHORIZATION_ENDPOINT=
KYRO_OIDC_TOKEN_ENDPOINT=
KYRO_OIDC_JWKS_URI=
KYRO_OIDC_REDIRECT_URI=
KYRO_OIDC_CLIENT_ID=
